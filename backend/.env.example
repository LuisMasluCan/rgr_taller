# Use the Neon pooled connection string for application queries.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require&channel_binding=require&connection_limit=1"

# Use the direct (non-pooler) Neon connection string for migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require&channel_binding=require"

# Required only when running the seed. Set a strong local password.
ADMIN_SEED_PASSWORD=""

# Local development API. Keep the API bound to loopback unless deployment is secured.
API_PORT="3001"
API_HOST="127.0.0.1"
API_ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# UploadThing API token for vehicle arrival photos
UPLOADTHING_TOKEN="eyJhcGlLZXkiOiJza19saXZlX...}"
