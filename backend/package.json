{
  "name": "rgr-taller-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch --exclude \"src/generated/prisma/**\" src/dev-server.ts",
    "start": "node dist/src/dev-server.js",
    "build": "prisma generate && tsc",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:seed:admin": "tsx prisma/seed-admin.ts",
    "db:set-admin-password": "tsx prisma/set-admin-password.ts",
    "db:check": "ts-node prisma/check-db.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.2",
    "dotenv": "^16.6.1",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/pg": "^8.15.5",
    "@types/node": "^24.0.0",
    "prisma": "^7.10.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.0"
  }
}
