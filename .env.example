# Neon pooled connection string used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require"

# Neon direct connection string used by Prisma migrations and build-time generation.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Only needed when creating the first administrator with the admin-only seed script.
ADMIN_SEED_PASSWORD="replace-with-a-unique-password-of-at-least-12-characters"

# Optional local API settings.
API_PORT="3001"
API_HOST="127.0.0.1"
API_ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# UploadThing API token for vehicle arrival photos
UPLOADTHING_TOKEN="eyJhcGlLZXkiOiJza19saXZlX...}"
